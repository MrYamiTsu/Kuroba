~~ ============================================
~~ TEST : GIVEN / CASE / BREAK / ~ (DEFAULT)
~~ ============================================

ivar role = "admin";

paste("--- Test 1 : Case avec match direct et break ---");
given role then
    case: "user"
        paste("Role: Simple utilisateur");
        break;
    case: "admin"
        paste("Role: Administrateur detecte !");
        break;
    case: ~
        paste("Role: Inconnu (Default)");
end

paste("--- Test 2 : Pas de match -> va directement au default ---");
ivar niveau = 999;
given niveau then
    case: 1
        paste("Niveau 1");
        break;
    case: 2
        paste("Niveau 2");
        break;
    case: ~
        paste("Niveau hors limites (Default atteint) !");
end

paste("--- Test 3 : Oubli du break -> saut DIRECT vers le default ---");
ivar etape = 1;
given etape then
    case: 1
        paste("Etape 1 commence (mais break oublie !)...");
    case: 2
        paste("ERREUR SI CECI S'AFFICHE (L'etape 2 ne doit pas s'executer)");
        break;
    case: ~
        paste("Securite TULG : renvoye direct dans le default !");
end
