pasteLn(">> ECHECS: " + failedCount);
pasteLn("================================================================================");

if (failedCount == 0) then
    pasteLn(">> FELICITATIONS: 100% DES CRASH TESTS SONT VALIDES !");
else
    pasteLn(">> ATTENTION: REGRESSIONS DETECTEES !");
end
