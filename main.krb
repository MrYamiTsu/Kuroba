import Std;
import StdE;

ivar passedCount = 0;
ivar failedCount = 0;
ivar totalCount = 0;

function assert(ivar~Bool cond, ivar~String msg) then
    totalCount = totalCount + 1;
    if cond then
        passedCount = passedCount + 1;
        pasteLn(StdE.Term.green("[PASS] " + msg));
    else
        failedCount = failedCount + 1;
        pasteLn(StdE.Term.red("[FAIL] " + msg));
    end
end

function assertEq(ivar val, ivar expected, ivar~String msg) then
    totalCount = totalCount + 1;
    if (val == expected) then
        passedCount = passedCount + 1;
        pasteLn(StdE.Term.green("[PASS] " + msg));
    else
        failedCount = failedCount + 1;
        pasteLn(StdE.Term.red("[FAIL] " + msg + " (Got: " + val + ", Expected: " + expected + ")"));
    end
end

pasteLn("================================================================================");
pasteLn(">> LANCEMENT DU CRASH TEST & TORTURE SUITE KUROBA v1.1.0");
pasteLn("================================================================================");

~~ ============================================================================
~~ SECTION 1: TYPED FUNCTION PARAMETERS & STRICT CONTRACTS (C ENGINE FIX TEST)
~~ ============================================================================
pasteLn("--- SECTION 1: PARAMETRES TYPES & CONTRATS STRICTS ---");

function fnTypedScalars(ivar~Int a, ivar~Float b, ivar~String c, ivar~Bool d) then
    return a + b;
end

ivar resScalar = fnTypedScalars("100", "25.5", 42, 1);
assertEq(resScalar, 125.5, "Typed parameters auto-coercion (String->Int, String->Float)");

function fnTypedStack(ivar~Stack<Int> sabot) then
    sabot.push(10);
    sabot.push(20);
    return sabot.pop();
end

ivar~Stack<Int> s1 = [];
ivar popVal = fnTypedStack(s1);
assertEq(popVal, 20, "Typed generic parameter ivar~Stack<Int>");
assertEq(s1.count(), 1, "Stack state preserved across typed parameter call");

function fnTypedList(ivar~List<Int> lst) then
    return lst.count();
end
ivar l1 = [1, 2, 3, 4, 5];
assertEq(fnTypedList(l1), 5, "Typed generic parameter ivar~List<Int>");

function fnStrictParam(ivar~(String) strictStr, ivar~Int num) then
    return strictStr + ":" + num;
end
assertEq(fnStrictParam("Alpha", 7), "Alpha:7", "Non-nullable parameter with valid argument");

ivar strictNullCaught = FALSE;
try then
    fnStrictParam(NULL, 10);
catch (ivar e) then
    strictNullCaught = TRUE;
end
assert(strictNullCaught, "Strict non-nullable parameter rejects NULL with TypeError");

function fnDefaultsWithTypes(ivar~Int a = 10, ivar~String b = "kuroba", ivar~Bool c = TRUE) then
    if c then
        return b + a;
    end
    return "NONE";
end
assertEq(fnDefaultsWithTypes(), "kuroba10", "Typed parameters with defaults (all omitted)");
assertEq(fnDefaultsWithTypes(99), "kuroba99", "Typed parameters with defaults (1 provided)");
assertEq(fnDefaultsWithTypes(5, "v", FALSE), "NONE", "Typed parameters with defaults (all provided)");

function fnNullableVsStrict(ivar~String optName, ivar~(String) reqName) then
    if (optName == NULL) then
        return "NULL_OK:" + reqName;
    end
    return optName + ":" + reqName;
end
assertEq(fnNullableVsStrict(NULL, "StrictVal"), "NULL_OK:StrictVal", "Nullable ivar~String accepts NULL argument");

function fnTransferQueues(ivar~Queue<Int> qSrc, ivar~Queue<Int> qDst) then
    while (qSrc.count() > 0) then
        qDst.push(qSrc.pop());
    end
    return qDst.count();
end

ivar~Queue<Int> srcQ = [10, 20, 30];
ivar~Queue<Int> dstQ = [1, 2];
ivar totalQueued = fnTransferQueues(srcQ, dstQ);
assertEq(totalQueued, 5, "Multiples parametres de collections generiques ivar~Queue<Int>");
assertEq(srcQ.count(), 0, "Queue source vidangee a travers appel type");
assertEq(dstQ.count(), 5, "Queue destination accumulee a travers appel type");
assertEq(dstQ.pop(), 1, "Ordre FIFO respecte dans Queue transferee (premier: 1)");
assertEq(dstQ.pop(), 2, "Ordre FIFO respecte dans Queue transferee (deuxieme: 2)");
assertEq(dstQ.pop(), 10, "Ordre FIFO respecte dans Queue transferee (troisieme: 10)");

