~~ ============================================================================
~~ Kuroba Std Library: String
~~ ============================================================================
namespace Std ~String then
    iconst DIGITS      = "0123456789";
    iconst ASCII_LOWER = "abcdefghijklmnopqrstuvwxyz";
    iconst ASCII_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    iconst upper      = __native_strUpper;
    iconst lower      = __native_strLower;
    iconst count      = __native_strCount;
    iconst trim       = __native_strTrim;
    iconst split      = __native_strSplit;
    iconst replace    = __native_strReplace;
    iconst contains   = __native_strContains;
    iconst startsWith = __native_strStartsWith;
    iconst endsWith   = __native_strEndsWith;
    iconst indexOf    = __native_strIndexOf;
    iconst slice      = __native_strSlice;
    iconst repeat     = __native_strRepeat;
    iconst reverse    = __native_strReverse;
    iconst join       = __native_strJoin;
end
