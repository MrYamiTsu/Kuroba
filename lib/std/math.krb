~~ ============================================================================
~~ Kuroba Std Library: Math
~~ ============================================================================

iconst PI  = 3.141592653589793;
iconst TAU = 6.283185307179586;
iconst E   = 2.718281828459045;

ivar random = __native_random;

function randomItem(ivar list) then
    if (list.count() == 0) then
        return NULL;
    end
    ivar idx = random(0, list.count() - 1);
    return list[idx];
end

function abs(ivar x) then
    if (x < 0) then
        return 0 - x;
    end
    return x;
end

function min(ivar a, ivar b) then
    if (a < b) then
        return a;
    end
    return b;
end

function max(ivar a, ivar b) then
    if (a > b) then
        return a;
    end
    return b;
end

function clamp(ivar val, ivar minVal, ivar maxVal) then
    if (val < minVal) then
        return minVal;
    end
    if (val > maxVal) then
        return maxVal;
    end
    return val;
end

function trunc(ivar x) then
    ivar i = 0;
    i~Int = x;
    return i;
end

function floor(ivar x) then
    ivar i = 0;
    i~Int = x;
    if (x < 0 && x != i) then
        return i - 1;
    end
    return i;
end

function ceil(ivar x) then
    ivar i = 0;
    i~Int = x;
    if (x > 0 && x != i) then
        return i + 1;
    end
    return i;
end

function round(ivar x) then
    return floor(x + 0.5);
end

function sqrt(ivar x) then
    return __native_sqrt(x);
end

function pow(ivar base, ivar exp) then
    return __native_pow(base, exp);
end

function dist(ivar x1, ivar y1, ivar x2, ivar y2) then
    ivar dx = x2 - x1;
    ivar dy = y2 - y1;
    return __native_sqrt((dx * dx) + (dy * dy));
end

function sin(ivar rad) then
    return __native_sin(rad);
end

function cos(ivar rad) then
    return __native_cos(rad);
end

function tan(ivar rad) then
    return __native_tan(rad);
end

function atan2(ivar y, ivar x) then
    return __native_atan2(y, x);
end

function degToRad(ivar deg) then
    return deg * (PI / 180.0);
end

function radToDeg(ivar rad) then
    return rad * (180.0 / PI);
end

function sign(ivar x) then
    if (x > 0) then return 1; end
    if (x < 0) then return 0 - 1; end
    return 0;
end

function lerp(ivar a, ivar b, ivar t) then
    return a + (b - a) * t;
end

function asin(ivar x) then
    return __native_asin(x);
end

function acos(ivar x) then
    return __native_acos(x);
end

function atan(ivar x) then
    return __native_atan(x);
end

function log(ivar x) then
    return __native_log(x);
end

function log10(ivar x) then
    return __native_log10(x);
end

function exp(ivar x) then
    return __native_exp(x);
end