~~ ============================================================================
~~ Kuroba Std Library: Math
~~ ============================================================================
namespace Std ~Math then
    iconst PI  = 3.141592653589793;
    iconst TAU = 6.283185307179586;
    iconst E   = 2.718281828459045;

    iconst random = __native_random;
    iconst sqrt   = __native_sqrt;
    iconst pow    = __native_pow;
    iconst sin    = __native_sin;
    iconst cos    = __native_cos;
    iconst tan    = __native_tan;
    iconst asin   = __native_asin;
    iconst acos   = __native_acos;
    iconst atan   = __native_atan;
    iconst atan2  = __native_atan2;
    iconst log    = __native_log;
    iconst log10  = __native_log10;
    iconst exp    = __native_exp;

    function randomItem(ivar list) then
        if (list.count() == 0) then
            return NULL;
        end
        ivar idx = random(0, list.count() - 1);
        return list[idx];
    end

    function abs(ivar x) then
        if (x < 0) then
            return 0 - x;
        end
        return x;
    end

    function min(ivar a, ivar b) then
        if (a < b) then
            return a;
        end
        return b;
    end

    function max(ivar a, ivar b) then
        if (a > b) then
            return a;
        end
        return b;
    end

    function clamp(ivar val, ivar minVal, ivar maxVal) then
        if (val < minVal) then
            return minVal;
        end
        if (val > maxVal) then
            return maxVal;
        end
        return val;
    end

    function trunc(ivar x) then
        ivar i = 0;
        i~Int = x;
        return i;
    end

    function floor(ivar x) then
        ivar i = 0;
        i~Int = x;
        if (x < 0 && x != i) then
            return i - 1;
        end
        return i;
    end

    function ceil(ivar x) then
        ivar i = 0;
        i~Int = x;
        if (x > 0 && x != i) then
            return i + 1;
        end
        return i;
    end

    function round(ivar x) then
        return floor(x + 0.5);
    end

    function dist(ivar x1, ivar y1, ivar x2, ivar y2) then
        ivar dx = x2 - x1;
        ivar dy = y2 - y1;
        return sqrt((dx * dx) + (dy * dy));
    end

    function degToRad(ivar deg) then
        return deg * (PI / 180.0);
    end

    function radToDeg(ivar rad) then
        return rad * (180.0 / PI);
    end

    function sign(ivar x) then
        if (x > 0) then return 1; end
        if (x < 0) then return 0 - 1; end
        return 0;
    end

    function lerp(ivar a, ivar b, ivar t) then
        return a + (b - a) * t;
    end
end