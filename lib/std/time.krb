~~ ============================================================================
~~ Kuroba Std Library: Time
~~ ============================================================================
namespace Std ~Time then
    iconst sleep  = __native_sleep;
    iconst now    = __native_now;
    iconst unix   = __native_unix;
    iconst perf   = __native_perf;
    iconst hires  = __native_perf;
    iconst clock  = __native_clock;
    iconst iso    = __native_iso;
    iconst format = __native_timeFormat;

    function sleepSec(ivar sec) then
        sleep(sec * 1000);
    end

    function since(ivar timestamp) then
        return now() - timestamp;
    end
    
    function stopwatch() then
        ivar start = now();
        return {
            elapsed: function ~() then
                return now() - start;
            end,
            reset: function ~() then
                start = now();
                return start;
            end
        };
    end
end
