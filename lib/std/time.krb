~~ ============================================================================
~~ Kuroba Std Library: Time
~~ ============================================================================
namespace Std ~Time then
    function sleep(ivar ms) then
        __native_sleep(ms);
    end

    function sleepSec(ivar sec) then
        sleep(sec * 1000);
    end

    function now() then
        return __native_now();
    end

    function unix() then
        return __native_unix();
    end

    function perf() then
        return __native_perf();
    end

    function hires() then
        return __native_perf();
    end

    function clock() then
        return __native_clock();
    end

    function iso() then
        return __native_iso();
    end

    function format(ivar ms) then
        return __native_timeFormat(ms);
    end

    function since(ivar timestamp) then
        return now() - timestamp;
    end
    
    function stopwatch() then
        ivar start = now();
        return {
            elapsed: function ~() then
                return now() - start;
            end,
            reset: function ~() then
                start = now();
                return start;
            end
        };
    end
end
